# Databricks CLI profile used to deploy the app and authenticate the relay (see ~/.databrickscfg).
DATABRICKS_PROFILE=

# Optional overrides (each can also be passed as a CLI flag, see `uv run mcp-relay --help`).
# APP_NAME=mcp-relay
# MCP_SERVERS_CONFIG=mcp_servers.json
# WORKSPACE_PATH=/Workspace/Users/<you>/mcp-relay
# MCP_ALLOWED_ORIGINS=https://<your-workspace-host>

# Shared secret between the relay and the app. Auto-generated and cached if unset.
# RELAY_SECRET=
